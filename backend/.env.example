# ==========================================
# FalkorDB Graph Database Configuration
# ==========================================
# Command to start FalkorDB in Docker:
# docker run -p 6379:6379 -it --rm falkordb/falkordb:latest
#
# FalkorDB Host (Use 'localhost' or '127.0.0.1' for local dev)
FALKORDB_HOST=localhost

# FalkorDB Port (Default FalkorDB/Redis port is 6379)
FALKORDB_PORT=6379

# FalkorDB Authentication (Leave empty if password authentication is disabled)
FALKORDB_USERNAME=
FALKORDB_PASSWORD=

# FalkorDB Target Graph / Database Name
FALKORDB_GRAPH_NAME=knowledge_graph

# Connection URL format (Alternative to host/port, supported by many clients)
FALKORDB_URL=redis://localhost:6379


# ==========================================
# OpenAI LLM & Embeddings Configuration
# ==========================================
# Your OpenAI API Key (starts with sk-...)
OPENAI_API_KEY=your_openai_api_key_here

# Default LLM model to use
OPENAI_MODEL=gpt-4o-mini

# Default Embedding model to use
OPENAI_EMBEDDING_MODEL=text-embedding-3-small


# ==========================================
# Application Configuration
# ==========================================
APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8000
LOG_LEVEL=INFO
